# Database
MONGODB_URI=mongodb://localhost:27017/ambulance-system

# JWT Secret - REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret

# Client URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Environment
NODE_ENV=development
PORT=5001
